[Unit]
Description=Dictate Agent - Voice Dictation Daemon
After=graphical-session.target
Wants=pulseaudio.service

[Service]
Type=simple
ExecStart=%h/.local/bin/dictate-agent
Restart=on-failure
RestartSec=5
Environment=DISPLAY=:0
Environment=RUST_LOG=dictate_agent=info

# Resource limits — whisper.cpp GGUF model + VRAM management
MemoryMax=4G
CPUQuota=80%

[Install]
WantedBy=default.target
