[Unit]
Description=dictated network API -> Mac app: reverse SSH tunnel (Mac private Unix socket)
Documentation=file:///%h/.local/share/dictate-agent/docs/MAC-APP.md
# Not Requires=/BindsTo=dictated.service: the tunnel only carries connections,
# and a forward that finds no listener just fails that one request. Ordering
# after dictated keeps the first Mac request from racing the API's bind.
After=dictated.service
# Never give up retrying (the Mac sleeps, Wi-Fi drops, the hub boots first).
StartLimitIntervalSec=0

# Install with `just install-mac-tunnel` (or `make install-mac-tunnel`).
# Security model and setup: docs/MAC-APP.md. In short:
#   * The hub dials out to the Mac; nothing new listens on the hub beyond
#     dictated's own loopback API, and the hub firewall is untouched.
#   * The Mac listens only on a Unix socket in its user's 0700 directory.
#     GatewayPorts affects TCP forwards only; no Mac TCP port is requested.
#     The wrapper prepares the directory and removes a stale socket before
#     each start (StreamLocalBindUnlink=no is supported). Exit 78 refuses an
#     unsafe path; link/forward failures are retried.
#   * Every byte rides the SSH session; every request still needs the bearer
#     token.
#
# Point it at another Mac, or other ports, with a drop-in instead of editing
# this file (`systemctl --user edit dictate-mac-tunnel`):
#   [Service]
#   Environment=DICTATE_MAC_HOST=my-other-mac
# Optional: Environment="DICTATE_MAC_SOCKET=/absolute/private/run/hub.sock"
# The socket path must fit Darwin's 103-byte limit. Custom hub ports also
# need that Host spelling in [api] allowed_hosts (the app sends 127.0.0.1:7313).

[Service]
Type=simple
# An ssh_config Host alias (or user@host). It must work non-interactively:
# key without a passphrase or a running agent, and the host key already in
# ~/.ssh/known_hosts (BatchMode never prompts; StrictHostKeyChecking=yes never
# accepts a new key on its own).
Environment=DICTATE_MAC_HOST=mac-mini
# The hub's [api] loopback bind port.
Environment=DICTATE_HUB_API_PORT=7313
# The wrapper's ssh options: BatchMode, StrictHostKeyChecking=yes, -N -T, no
# agent or X11 forwarding, ExitOnForwardFailure (a socket still held by a stale
# session means exit and retry, not "up with no tunnel"), ServerAlive 15 s x 3,
# ControlPath=none (never ride, or become, a shared master connection).
# `make install-mac-tunnel` rewrites this path to its BINDIR.
ExecStart=%h/.local/bin/dictate-mac-tunnel
Restart=always
RestartSec=10
# 78 = refused for safety (see above): stay down instead of retrying.
RestartPreventExitStatus=78

[Install]
WantedBy=default.target
