# Build artifacts (legacy generic rules kept as-is; no Python is tracked)
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/


# IDE
.idea/
.vscode/
*.swp
*.swo

# Project specific
src_rust_archive/
target/
models/*.bin
models/*.onnx

# Config with secrets
config/config.toml

# The `lib/` rule above must not swallow the UI's TypeScript modules (S32)
!ui/src/lib/

# Release tarballs staged by scripts/package.sh
dist/
