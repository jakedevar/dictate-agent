#!/usr/bin/env bash
# Reverse Unix-socket SSH forward for DictateHub. No Mac TCP listener exists,
# so GatewayPorts cannot widen its exposure. Exit 78 = unsafe local/socket
# configuration (no restart); 1 = link/forward failure (retry).
# --check prepares/checks the private directory, but does not unlink a socket.
# Environment: DICTATE_MAC_HOST (mac-mini), DICTATE_HUB_API_PORT (7313),
# DICTATE_MAC_SOCKET (absolute Mac path; default ~/Library/Application
# Support/DictateHub/run/hub.sock), DICTATE_MAC_SSH (ssh),
# DICTATE_MAC_PREPARE_SECS (20; local wall-clock deadline).
set -uo pipefail
host=${DICTATE_MAC_HOST:-mac-mini}
port=${DICTATE_HUB_API_PORT:-7313}
socket=${DICTATE_MAC_SOCKET:-}
ssh_bin=${DICTATE_MAC_SSH:-ssh}
secs=${DICTATE_MAC_PREPARE_SECS:-20}
log() { printf 'dictate-mac-tunnel: %s\n' "$*" >&2; }
refuse() { log "REFUSED: $*"; exit 78; }
case "$host" in ''|-*) refuse 'invalid host' ;; esac
[[ $port =~ ^[0-9]{1,5}$ ]] && ((port > 0 && port <= 65535)) || refuse 'invalid hub port'
[[ $secs =~ ^[0-9]{1,3}$ ]] && ((secs > 0)) || refuse 'invalid prepare deadline'
case "$socket" in *"'"*|*:*|*$'\n'*|*$'\r'*) refuse 'invalid socket path' ;; esac
[[ -z $socket || $socket = /* ]] || refuse 'socket path must be absolute'
mode=${1:-run}
case "$mode" in run|--check) ;; -h|--help) sed -n '2,10p' "$0"; exit 0 ;; *) refuse 'unknown argument' ;; esac
opts=(-o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=15
      -o ControlMaster=no -o ControlPath=none -o ForwardAgent=no
      -o ForwardX11=no -o PermitLocalCommand=no -o ForkAfterAuthentication=no)
# A Host block must not sneak additional forwards into this transport. The
# check session clears them; the tunnel must retain its own explicit -R.
config=$(timeout --kill-after=2 "$secs" "$ssh_bin" "${opts[@]}" -o ClearAllForwardings=no -G "$host") || { log 'ssh configuration unavailable'; exit 1; }
if LC_ALL=C grep -qiE '^(localforward|remoteforward|dynamicforward) ' <<<"$config"; then
    refuse 'remove configured forwards from the SSH host alias'
fi
# Shell arguments contain no single quote; everything else stays quoted on
# the remote shell. Only owned, non-symlink directories may contain the UDS.
# Do not inspect on-disk sshd policy: ExitOnForwardFailure tests the running
# daemon's actual permission to create this Unix socket.
remote='
set -eu
umask 077
sock=$1; mode=$2
if [ -z "$sock" ]; then
    base="$HOME/Library/Application Support/DictateHub"
    for d in "$base" "$base/run"; do
        if [ -L "$d" ]; then echo "REFUSE symlinked socket directory"; exit 78; fi
        if [ ! -e "$d" ]; then mkdir "$d"; fi
        [ -d "$d" ] && [ -O "$d" ] || { echo "REFUSE unowned socket directory"; exit 78; }
        chmod 700 "$d"
    done
    sock="$base/run/hub.sock"
else
    d=${sock%/*}
    [ ! -L "$d" ] && [ -d "$d" ] && [ -O "$d" ] || { echo "REFUSE socket parent must be an owned directory"; exit 78; }
    chmod 700 "$d"
fi
# Darwin sun_path holds 104 bytes, including the NUL. Reject all separators
# understood by ssh forwarding syntax, and shell quotes in the returned HOME.
case "$sock" in *:*|*\"* ) echo "REFUSE invalid resolved path"; exit 78 ;; esac
bytes=$(LC_ALL=C printf %s "$sock" | wc -c | tr -d " ")
[ "$bytes" -lt 104 ] || { echo "REFUSE socket path exceeds 103 bytes"; exit 78; }
if [ -L "$sock" ] || { [ -e "$sock" ] && [ ! -S "$sock" ]; }; then
    echo "REFUSE socket destination is not a socket"; exit 78
fi
if [ "$mode" = run ] && [ -S "$sock" ]; then rm -- "$sock"; fi
printf "%s\n" "$sock"
'
out=$(timeout --kill-after=2 "$secs" "$ssh_bin" "${opts[@]}" -T \
    -o ClearAllForwardings=yes -o SessionType=default "$host" \
    "sh -c '$remote' dictate-mac-tunnel '$socket' '$mode'")
rc=$?
if ((rc != 0)); then
    if ((rc == 78)); then refuse "$out"; fi
    log "socket preparation failed or timed out (status $rc)"; exit 1
fi
socket=$out
case "$socket" in /*) ;; *) refuse 'invalid socket preparation reply' ;; esac
case "$socket" in *:*|*"'"*|*$'\n'*|*$'\r'*) refuse 'invalid resolved socket path' ;; esac
[[ ${#socket} -lt 104 ]] || refuse 'socket path too long'
if [[ $mode = --check ]]; then log 'private socket directory ready (forward not started)'; exit 0; fi
log "starting private Unix-socket tunnel to $host (no Mac TCP listener)"
# Keep the original wrapper contract: 0 on stop, 1 on link/forward failure,
# 78 on configuration refusal. There is no post-start checker. The wrapper
# owns exactly one SSH child and reaps it on every normal/stop path.
tunnel_pid=""
stopping=0
stop_tunnel() {
    stopping=1
    if [[ -n $tunnel_pid ]]; then kill -TERM "$tunnel_pid" 2>/dev/null || true; fi
}
trap stop_tunnel TERM INT HUP
"$ssh_bin" "${opts[@]}" -n -N -T -o ClearAllForwardings=no -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
    -R "$socket:127.0.0.1:$port" "$host" &
tunnel_pid=$!
if ((stopping)); then stop_tunnel; fi
wait "$tunnel_pid"
rc=$?
if ((stopping)); then
    # A signal can interrupt wait before SSH has exited.
    wait "$tunnel_pid" 2>/dev/null || true
    exit 0
fi
log "tunnel ended (ssh status $rc); retrying later"
exit 1
